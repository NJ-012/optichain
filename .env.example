# Local development. For Vercel, set this to the actual HTTPS Render service
# origin in the Vercel project build environment before deploying.
VITE_API_BASE_URL=http://localhost:8000

# Optional request deadlines (positive whole milliseconds). Planning also
# allows its configured solver limit plus a five-second response margin.
VITE_API_HEALTH_TIMEOUT_MS=10000
VITE_API_PLANNING_TIMEOUT_MS=40000
VITE_API_ROUTING_TIMEOUT_MS=30000

# Comma-separated browser origins allowed by FastAPI. Keep only the local
# origins and exact deployed frontend origins required by the deployment.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://optichain-ikuck8atz-jniyati06-projects.vercel.app,https://optichain-i9txwi118-njiyati06-1446s-projects.vercel.app,https://optichain-i9txw118-njiyati06-1446s-projects.vercel.app
